LLM_PROVIDER=google

# Fill in the credentials for your selected provider only.
GOOGLE_API_KEY=
GOOGLE_MODEL_ID=gemini-3.5-flash-lite
GOOGLE_EMBEDDING_MODEL_ID=gemini-embedding-2

AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID_CLAUDE=global.anthropic.claude-sonnet-4-6

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o

# Run Ollama locally and pull the selected model; no API key is required.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_ID=llama3.1
